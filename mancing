-- ===== Ultra Low Texture Scanner (Auto Update) =====
local ultraLowEnabled = false
local savedStates = {}
local scanConnection = nil
 
-- Simpan property dengan aman
local function saveState(obj, prop, value)
    if not savedStates[obj] then savedStates[obj] = {} end
    if savedStates[obj][prop] == nil then
        savedStates[obj][prop] = value
    end
end
 
-- Terapkan ultra low
local function applyUltraLow(obj)
    if obj:IsA("Decal") or obj:IsA("Texture") then
        saveState(obj, "Transparency", obj.Transparency)
        pcall(function() obj.Transparency = 1 end)
 
    elseif obj:IsA("MeshPart") then
        saveState(obj, "TextureID", obj.TextureID)
        saveState(obj, "Material", obj.Material)
        pcall(function() obj.TextureID = "" end)
        pcall(function() obj.Material = Enum.Material.Plastic end)
 
    elseif obj:IsA("SpecialMesh") or obj:IsA("Mesh") then
        saveState(obj, "TextureId", obj.TextureId)
        pcall(function() obj.TextureId = "" end)
 
    elseif obj:IsA("BasePart") then
        saveState(obj, "Material", obj.Material)
        pcall(function() obj.Material = Enum.Material.Plastic end)
    end
end
 
-- Restore state
local function restoreUltraLow(obj)
    if savedStates[obj] then
        for prop, val in pairs(savedStates[obj]) do
            if obj and obj.Parent ~= nil then
                pcall(function() obj[prop] = val end)
            end
        end
        savedStates[obj] = nil
    end
end
 
-- Aktifkan/Nonaktifkan Scanner
local function setUltraLowMode(enable)
    ultraLowEnabled = enable
    if enable then
        -- Apply langsung ke semua object yang sudah ada
        for _, obj in ipairs(workspace:GetDescendants()) do
            applyUltraLow(obj)
        end
 
        -- Auto-scan untuk object baru / update lokasi
        scanConnection = workspace.DescendantAdded:Connect(function(obj)
            if ultraLowEnabled then
                applyUltraLow(obj)
            end
        end)
 
        Rayfield:Notify({
            Title = "Ultra Low Scanner",
            Content = "Scanner aktif ✅ (otomatis deteksi texture)",
            Duration = 3
        })
    else
        -- Matikan scanner
        if scanConnection then
            scanConnection:Disconnect()
            scanConnection = nil
        end
 
        -- Kembalikan semua object
        for obj, _ in pairs(savedStates) do
            restoreUltraLow(obj)
        end
        savedStates = {}
 
        Rayfield:Notify({
            Title = "Ultra Low Scanner",
            Content = "Scanner nonaktif ❌ (kembali normal)",
            Duration = 3
        })
    end
end
 
-- Toggle UI
TabUtility:CreateToggle({
    Name = "Ultra Low Scanner 🟦",
    CurrentValue = false,
    Callback = function(Value)
        setUltraLowMode(Value)
    end
})
