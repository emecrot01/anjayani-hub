-- ====== AUTO FISHING + COUNTER ======
local running = false
local currentFishCount = 0

-- Remote SellAll
local SellAllRemote = Net["RF/SellAllItems"]

-- Auto Sell config
local autoSellActive = false
local targetFishCount = 0

-- Auto Sell Function (fix anti-stuck)
local function autoSellCheck()
    if autoSellActive and SellAllRemote and targetFishCount > 0 and currentFishCount >= targetFishCount then
        task.spawn(function()
            local ok, err = pcall(function()
                SellAllRemote:InvokeServer()
            end)
            if ok then
                task.wait(0.3) -- safe delay biar server sempet proses
                Rayfield:Notify({
                    Title = "Auto Sell 💰",
                    Content = ("Sold %d fishes ✅"):format(currentFishCount),
                    Duration = 1
                })
                currentFishCount = 0 -- reset setelah sell
            else
                warn("[Fish It] SellAll failed:", err)
            end
        end)
    end
end

-- Auto Fishing loop (versi stabil ++ anti stuck)
local function fish()
    task.wait(1) -- startup delay sekali sebelum mulai
    while running do
        -- 🎣 lempar joran
        Net["RF/ChargeFishingRod"]:InvokeServer(tick())
        task.wait(0.2) -- delay awal biar aman

        -- 🎮 start minigame
        Net["RF/RequestFishingMinigameStarted"]:InvokeServer(-1 + math.random(), 1)
        task.wait(1 + math.random() * 0.2) -- delay utama (ikan gigit umpan)

        -- ✅ complete minigame (reel in)
        Net["RE/FishingCompleted"]:FireServer()
        task.wait(0.3 + math.random() * 0.2) -- delay kedua (reel confirm)

        -- 🔁 extra confirm biar anti stuck
        Net["RE/FishingCompleted"]:FireServer()

        -- 🐟 increment counter
        currentFishCount += 1
        print("Ikan 🐟: " .. currentFishCount)
        autoSellCheck()

        -- 🔄 jeda sebelum loop berikutnya (0.5 - 0.6 total siklus)
        task.wait(0.5 + math.random() * 0.1)
    end
end

TabFishing:CreateToggle({
