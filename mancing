            Content = "Teleported to " .. locationName .. " ✅",
            Duration = 3
        })
    else
        Rayfield:Notify({
            Title = "Teleport ✈️",
            Content = "HumanoidRootPart not found ❌",
            Duration = 3
        })
    end
end

