    Name = "Infinity Oxygen 🤿♾️",
    Callback = function()
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local Net = ReplicatedStorage:WaitForChild("Packages")
            :WaitForChild("_Index")
