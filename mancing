-- ====== STOP FUNCTION ======
local function stopFishing()
    fishingActive = false
    currentFishCount = 0 -- reset counter
    isAutoFishLoopRunning = false -- reset biar bisa start lagi
    print("[Mammoth Fish It] Fishing stopped and state reset")
end

-- ====== AUTO FISH LOOP (Optimized Delay + Failsafe) ======
local function autoFishLoop()
    local notifyCooldown = 0
    isAutoFishLoopRunning = true

    while fishingActive do
        local cycleStart = tick()

        -- Cari remote kalau hilang
        if not (ChargeRod and RequestMinigame and FishingComplete) then
            if not findRemotes() then
                if tick() - notifyCooldown > 5 then
                    Rayfield:Notify({
                        Title = "Mammoth Fish It",
                        Content = "Remotes not found. Retrying...",
                        Duration = 3
                    })
                    notifyCooldown = tick()
                end
                task.wait(2 + math.random())
                continue
            end
        end

        -- Cast Fishing Rod
        local success = pcall(function()
            if ChargeRod.InvokeServer then
                ChargeRod:InvokeServer(tick())
            else
                ChargeRod:FireServer(tick())
            end
        end)
        if not success then
            task.wait(1 + math.random())
            continue
        end

        -- Delay cast (0.15 - 0.25 detik)
        task.wait(0.15 + math.random() * 0.1)

        -- Start Minigame
        pcall(function()
            if RequestMinigame.InvokeServer then
                RequestMinigame:InvokeServer(-1 + math.random(), 1)
            else
                RequestMinigame:FireServer(-1 + math.random(), 1)
            end
        end)

        -- Tunggu sebelum complete (0.7 - 1.4 detik) ✅ FIXED
        task.wait(0.7 + math.random() * 0.7)

        -- Complete Fishing (pakai failsafe 2x)
        local function safeComplete()
            for i = 1, 2 do
                local ok = pcall(function()
                    FishingComplete:FireServer()
                end)
                if ok then
                    print("[Mammoth Fish It] FishingComplete sent")
                else
                    warn("[Mammoth Fish It] Failed to send FishingComplete")
                end
                task.wait(0.4 + math.random() * 0.2)
            end
        end
        safeComplete()

        currentFishCount += 1
        print(("[Mammoth Fish It] Caught fish #%d"):format(currentFishCount))

        -- 🔹 Auto Sell check
        if autoSellActive and SellAll and targetFishCount and currentFishCount >= targetFishCount then
            local ok, err = pcall(function()
                if SellAll.InvokeServer then
                    SellAll:InvokeServer("Fishes")
                else
                    SellAll:FireServer("Fishes")
                end
            end)
            if ok then
                Rayfield:Notify({
                    Title = "Mammoth Fish It",
                    Content = ("Sold %d fishes"):format(currentFishCount),
                    Duration = 3
                })
                currentFishCount = 0
            else
                warn("[Mammoth Fish It] SellAll failed:", err)
            end
        end

        -- 🔹 Emergency reset kalau 1 cycle terlalu lama
        if tick() - cycleStart > 5 then
            warn("[Mammoth Fish It] Emergency reset triggered")
            safeComplete()
        end

        -- 🔹 Slider-based interval (buat kontrol speed loop)
        task.wait(fishingDelay)
    end

    -- keluar loop = stop otomatis
    isAutoFishLoopRunning = false
end

