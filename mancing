local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Rayfield = Rayfield -- asumsi udah ada Rayfield di Hub

local Net, SellAll, ChargeRod, RequestMinigame, FishingComplete

local function findRemotes()
    local packages = ReplicatedStorage:FindFirstChild("Packages")
    if packages then
        local index = packages:FindFirstChild("_Index")
        if index then
            local sleit = index:FindFirstChild("sleitnick_net@0.2.0")
            if sleit then
                Net = sleit:FindFirstChild("net")
                if Net then
                    ChargeRod = Net:FindFirstChild("RF/ChargeFishingRod")
                    RequestMinigame = Net:FindFirstChild("RF/RequestFishingMinigameStarted")
                    FishingComplete = Net:FindFirstChild("RE/FishingCompleted")
                    SellAll = Net:FindFirstChild("RF/SellAllItems")
                end
            end
        end
    end
end
findRemotes()

