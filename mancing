-- ===== Platform =====
local function createSteadyPlatform(hrp)
    if not platformPart then
        platformPart = Instance.new("Part")
        platformPart.Size = Vector3.new(2,1,2)
        platformPart.Anchored = true
        platformPart.Transparency = 1
        platformPart.CanCollide = true
        platformPart.CFrame = hrp.CFrame - Vector3.new(0,(hrp.Size.Y/2)+2,0)
        platformPart.Parent = workspace
    else
        platformPart.CFrame = hrp.CFrame - Vector3.new(0,(hrp.Size.Y/2)+2,0)
    end
end

local function removeSteadyPlatform()
    if platformPart then
        platformPart:Destroy()
        platformPart = nil
    end
end

-- ===== Find Event Model =====
local function findEventModel(uiName)
    local realName = eventMap[uiName] or uiName
    for _, obj in ipairs(workspace:GetDescendants()) do
        if string.lower(obj.Name) == string.lower(realName) then
            if obj:IsA("Model") or obj:IsA("Folder") then
                return obj
            end
        end
    end
    return nil
end

-- ===== Get Target Part =====
local function getTargetPart(uiName)
    if uiName == "Ghost Worm Fish 🐛👻" then
        local rings = workspace:FindFirstChild("RINGS")
        local props = rings and rings:FindFirstChild("Props")
        local model = props and props:FindFirstChild("Ghost Worm Fish")
        if not model then return nil end

        local part = model:FindFirstChild("Part") or model:FindFirstChild("BlackHole")
        if part then return part end
        return model:FindFirstChildWhichIsA("BasePart", true)
    else
        local model = findEventModel(uiName)
        if not model then return nil end

        local spawn = model:FindFirstChild("Spawn") or model:FindFirstChild("spawn")
        if spawn and spawn:IsA("BasePart") then return spawn end

        local boat = model:FindFirstChild("Fishing Boat")
        if boat then
            if boat.PrimaryPart then return boat.PrimaryPart end
            return boat:FindFirstChildWhichIsA("BasePart", true)
        end

        return model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
    end
end

-- ===== Teleport =====
local function teleportToTarget(char)
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (hrp and selectedTarget) then return end
    if not originalCFrame and not returningToOriginal then
        originalCFrame = hrp.CFrame
    end

    local realName = eventMap[selectedTarget]
    local targetPart = getTargetPart(selectedTarget)
    if not targetPart then return end

    -- Shark / Ghost → depan kapal
    if realName == "Shark Hunt" or realName == "Ghost Shark Hunt" then
        local model = findEventModel(selectedTarget)
        local boat = model and model:FindFirstChild("Fishing Boat")
        local base = boat and (boat:FindFirstChild("Base") or boat.PrimaryPart or boat:FindFirstChildWhichIsA("BasePart", true))
        if base then
            hrp.CFrame = CFrame.new(
                (base.CFrame * CFrame.new(0,7,-24)).Position,
                (base.CFrame * CFrame.new(0,7,-25)).Position
            )
            createSteadyPlatform(hrp)
            return
        end
    end

    -- Megalodon
    if realName == "Megalodon Hunt" then
        local pos = targetPart.Position + Vector3.new(0,9.5,0)
        local sharkModel = findEventModel("Shark Hunt 🦈")
        local sharkBoat = sharkModel and sharkModel:FindFirstChild("Fishing Boat")
        local sharkBase = sharkBoat and (sharkBoat:FindFirstChild("Base") or sharkBoat.PrimaryPart or sharkBoat:FindFirstChildWhichIsA("BasePart", true))
        if sharkBase then
            hrp.CFrame = CFrame.new(pos, pos + sharkBase.CFrame.LookVector)
        else
            hrp.CFrame = CFrame.new(pos, pos + Vector3.new(0,0,1))
        end
        createSteadyPlatform(hrp)
        return
    end

    -- Ghost Worm Fish / default
    hrp.CFrame = targetPart.CFrame + Vector3.new(0,9.5,0)
    createSteadyPlatform(hrp)
end

-- ===== Loop Teleport =====
local function startTeleportLoop()
    if teleportLoopRunning then return end
    teleportLoopRunning = true
 
    task.spawn(function()
        while autoTeleportEnabled do
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local targetPart = getTargetPart(selectedTarget)
                if targetPart then
                    teleportToTarget(char)
                else
                    if originalCFrame then
                        returningToOriginal = true
                        char.HumanoidRootPart.CFrame = originalCFrame
                        removeSteadyPlatform()
                        originalCFrame = nil
                        returningToOriginal = false
                    end
                end
            end
            task.wait(5)
        end
        teleportLoopRunning = false
    end)
end
 
