TabFarm:CreateSection("Automatic Fishing 🎣")
 
local running = false
local currentFishCount = 0
local autoSellActive = false
local targetFishCount = 0
local selectedMode = nil
 
local SellAllRemote = Net["RF/SellAllItems"]
 
local function autoSellCheck()
    if autoSellActive and SellAllRemote and targetFishCount > 0 and currentFishCount >= targetFishCount then
        task.spawn(function()
            local ok, err = pcall(function()
                SellAllRemote:InvokeServer()
            end)
            if ok then
                task.wait(0.1)
                Rayfield:Notify({
                    Title = "Auto Sell 💰",
                    Content = ("Sold %d fishes ✅"):format(currentFishCount),
                    Duration = 1
                })
                currentFishCount = 0
            else
                warn("[Fish It] SellAll failed:", err)
            end
        end)
    end
end
 
local function fishSlow()
    task.wait(2)
    while running do
        Net["RF/ChargeFishingRod"]:InvokeServer(tick())
        task.wait(0.5)
        Net["RF/RequestFishingMinigameStarted"]:InvokeServer(-1 + math.random(), 1)
        task.wait(1 + math.random() * 1)
        Net["RE/FishingCompleted"]:FireServer()
        task.wait(0.5 + math.random() * 0.2)
        Net["RE/FishingCompleted"]:FireServer()
 
        currentFishCount = currentFishCount + 1
        autoSellCheck()
        task.wait(0.25)
    end
end
 
local function fishFast()
    task.wait(1)
    while running do
        Net["RF/ChargeFishingRod"]:InvokeServer(tick())
        task.wait(0.02)
        Net["RF/RequestFishingMinigameStarted"]:InvokeServer(-1 + math.random(), 1)
        task.wait(0.57)
        Net["RE/FishingCompleted"]:FireServer()
        task.wait(0.28)
        Net["RE/FishingCompleted"]:FireServer()
 
        currentFishCount = currentFishCount + 1
        autoSellCheck()
        task.wait(0.25)
    end
end
 
