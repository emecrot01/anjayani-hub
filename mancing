-- 🔘 Infinity Oxygen (Button)
TabUtility:CreateButton({
    Name = "Infinity Oxygen 🤿♾️",
    Callback = function()
        local Players = game:GetService("Players")
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local LocalPlayer = Players.LocalPlayer

        -- Cari package Net
        local Net = ReplicatedStorage:WaitForChild("Packages")
            :WaitForChild("_Index")
            :FindFirstChild("sleitnick_net@0.2.0")
            :WaitForChild("net")

        -- Remote Oxygen
        local OxygenEvent = Net:FindFirstChild("URE/UpdateOxygen")

        -- Hook metamethod buat blokir FireServer oxygen damage
        local mt = getrawmetatable(game)
        setreadonly(mt, false)
        local oldNamecall = mt.__namecall

        mt.__namecall = function(self, ...)
            local method = getnamecallmethod()
            if self == OxygenEvent and method == "FireServer" then
                return nil
            end
            return oldNamecall(self, ...)
        end

        setreadonly(mt, true)

        Rayfield:Notify({
            Title = "Infinity Oxygen",
            Content = "Aktif ✅ (ga bisa dimatiin, rejoin untuk reset)",
            Duration = 5
        })
    end,
})

