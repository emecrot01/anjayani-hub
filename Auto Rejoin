--[[
    Ambatukam Rejoin
    Automatic Retry
    Delta Mobile
]]

repeat task.wait(1) until game:IsLoaded()

local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local TeleportService = game:GetService("TeleportService")
local GuiService = game:GetService("GuiService")

local player = Players.LocalPlayer
local placeId = game.PlaceId

local retryInterval = 0.1
local retryWindow = 10

local active = true
local reconnecting = false

print("Ambatukam Rejoin: Active")

local function isErrorPromptVisible()
    local promptGui = CoreGui:FindFirstChild("RobloxPromptGui")
    local overlay = promptGui and promptGui:FindFirstChild("promptOverlay")

    if not overlay then
        return false
    end

    for _, child in ipairs(overlay:GetChildren()) do
        if child.Name == "ErrorPrompt" then
            return true
        end
    end

    return false
end

local function startReconnect()
    if reconnecting or not active then
        return
    end

    reconnecting = true

    task.spawn(function()
        while active and isErrorPromptVisible() do
            local cycleStart = os.clock()

            repeat
                if not active or not isErrorPromptVisible() then
                    break
                end

                pcall(function()
                    TeleportService:Teleport(placeId, player)
                end)

                task.wait(retryInterval)
            until os.clock() - cycleStart >= retryWindow

            task.wait(retryInterval)
        end

        reconnecting = false
    end)
end

task.spawn(function()
    while active do
        if isErrorPromptVisible() then
            startReconnect()
        end

        task.wait(retryInterval)
    end
end)

pcall(function()
    GuiService.ErrorMessageChanged:Connect(function(message)
        if message and message ~= "" then
            startReconnect()
        end
    end)
end)

player.OnTeleport:Connect(function(state)
    if state == Enum.TeleportState.Started
        or state == Enum.TeleportState.InProgress then
        print("Ambatukam Rejoin: Teleport started")
    end
end)
