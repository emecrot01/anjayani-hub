--[[
    Auto Reconnect By Ambatukam
    Retry + Teleport Update v2
]]

repeat task.wait(1) until game:IsLoaded()

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local PlaceId = game.PlaceId

-- Configuration
local CONFIG = {
    ScanDelay = 4,
    RetryDelay = 5,
    MaxRetryDelay = 30,
    MaxPages = 5,
    RequestTimeout = 10,
    MaxTeleportAttempts = 16,
    MinFreeSlots = 1,
    TeleportTimeout = 20,
}

-- Error codes that stop Auto Reconnect
local STOP_CODES = {
    268, 256, 273, 264, 270, 278,
    280, 403, 524, 600, 6000, 1001
}

-- Error codes that trigger Auto Reconnect
local RECONNECT_CODES = {
    266, 277, 279, 528, 769
}

-- Runtime state
local excludedServers = {}
local busy = false
local stopped = false
local lastPrompt = nil
local lastError = ""
local currentTarget = nil
local reconnectRequested = false

local promptConnection = nil
local teleportFailedConnection = nil
local teleportStateConnection = nil

print("Auto Rejoin: Active")

local function stopReconnect()
    stopped = true
    reconnectRequested = false
    currentTarget = nil
end

local function requestJson(url)
    local ok, result = pcall(function()
        local response = game:HttpGet(url)
        return HttpService:JSONDecode(response)
    end)

    if not ok or type(result) ~= "table" then
        lastError = tostring(result)
        return nil
    end

    return result
end

-- Find a random eligible public server.
-- Previously attempted servers are excluded.
local function findPublicServer()
    local cursor = nil
    local candidates = {}

    for page = 1, CONFIG.MaxPages do
        if stopped then
            return nil
        end

        local url =
            "https://games.roblox.com/v1/games/"
            .. tostring(PlaceId)
            .. "/servers/Public?sortOrder=Asc&limit=100"

        if cursor and cursor ~= "" then
            url = url .. "&cursor="
                .. HttpService:UrlEncode(cursor)
        end

        local data = requestJson(url)

        if not data then
            return nil
        end

        if type(data.data) == "table" then
            for _, server in ipairs(data.data) do
                local id = server.id
                local playing = tonumber(server.playing) or 0
                local maximum = tonumber(server.maxPlayers) or 0

                if id
                    and tostring(id) ~= tostring(game.JobId)
                    and not excludedServers[tostring(id)]
                    and maximum > 0
                    and maximum - playing >= CONFIG.MinFreeSlots
                then
                    table.insert(candidates, tostring(id))
                end
            end
        end

        cursor = data.nextPageCursor

        if not cursor or cursor == "" then
            break
        end

        task.wait(0.25)
    end

    if #candidates == 0 then
        return nil
    end

    -- Shuffle candidates so selection is not always
    -- biased toward the first server in the API response.
    for i = #candidates, 2, -1 do
        local j = math.random(1, i)
        candidates[i], candidates[j] =
            candidates[j], candidates[i]
    end

    return candidates[1]
end

local function attemptTeleport(serverId)
    if stopped or not serverId then
        return false
    end

    serverId = tostring(serverId)

    -- Exclude immediately, even if teleport fails to start.
    excludedServers[serverId] = true
    currentTarget = serverId

    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(
            PlaceId,
            serverId,
            LocalPlayer
        )
    end)

    if not ok then
        lastError = tostring(err)

        if currentTarget == serverId then
            currentTarget = nil
        end

        return false
    end

    return true
end

-- Only one reconnect worker can run at a time.
local function requestReconnect(reason)
    if stopped then
        return
    end

    reconnectRequested = true

    if busy then
        return
    end

    busy = true

    task.spawn(function()
        local attempts = 0

        while not stopped
            and reconnectRequested
            and attempts < CONFIG.MaxTeleportAttempts
        do
            reconnectRequested = false
            attempts += 1

            local serverId = findPublicServer()

            if stopped then
                break
            end

            if serverId then
                local started = attemptTeleport(serverId)

                if started then
                    local deadline =
                        os.clock() + CONFIG.TeleportTimeout

                    while not stopped
                        and currentTarget == serverId
                        and os.clock() < deadline
                    do
                        task.wait(0.25)

                        if game.PlaceId ~= PlaceId then
                            stopReconnect()
                            break
                        end
                    end

                    if stopped then
                        break
                    end

                    -- If target is still active, it timed out.
                    -- The next loop will choose another server.
                    if currentTarget == serverId then
                        currentTarget = nil
                    end
                end
            end

            if stopped then
                break
            end

            -- Retry immediately with a different server.
            -- No backoff between failed teleport attempts.
            if attempts < CONFIG.MaxTeleportAttempts then
                reconnectRequested = true
            end
        end

        currentTarget = nil
        busy = false
    end)
end

-- Read text exposed by Roblox UI descendants.
local function readPromptText(prompt)
    local parts = {}

    local function collectText(object)
        if object:IsA("TextLabel")
            or object:IsA("TextButton")
            or object:IsA("TextBox")
        then
            local value = object.Text

            if type(value) == "string" and value ~= "" then
                table.insert(parts, value)
            end
        end
    end

    collectText(prompt)

    for _, descendant in ipairs(prompt:GetDescendants()) do
        collectText(descendant)
    end

    return table.concat(parts, " ")
end

local function containsCode(message, code)
    local pattern = "%f[%d]" .. tostring(code) .. "%f[^%d]"
    return string.find(message, pattern) ~= nil
end

local function handleErrorPrompt(prompt)
    if stopped or prompt == lastPrompt then
        return
    end

    lastPrompt = prompt

    local message = ""

    for _ = 1, 8 do
        if stopped or not prompt.Parent then
            return
        end

        message = readPromptText(prompt)
        local normalized = string.lower(message)

        for _, code in ipairs(STOP_CODES) do
            if containsCode(normalized, code) then
                stopReconnect()
                return
            end
        end

        if message ~= "" then
            break
        end

        task.wait(0.25)
    end

    if stopped then
        return
    end

    for _, code in ipairs(RECONNECT_CODES) do
        if containsCode(message, code) then
            requestReconnect("Recognized connection error")
            return
        end
    end
end

-- Teleport initialization failure.
pcall(function()
    teleportFailedConnection =
        TeleportService.TeleportInitFailed:Connect(
            function(player, result, errorMessage)
                if player ~= LocalPlayer or stopped then
                    return
                end

                lastError = tostring(errorMessage)

                if currentTarget then
                    currentTarget = nil
                    requestReconnect("Teleport initialization failed")
                end
            end
        )
end)

-- Watch Roblox error prompts.
task.spawn(function()
    local promptGui = CoreGui:WaitForChild(
        "RobloxPromptGui",
        30
    )

    if not promptGui or stopped then
        return
    end

    local overlay = promptGui:FindFirstChild("promptOverlay")

    if not overlay then
        overlay = promptGui:WaitForChild("promptOverlay", 15)
    end

    if not overlay or stopped then
        return
    end

    for _, child in ipairs(overlay:GetChildren()) do
        if child.Name == "ErrorPrompt" then
            task.spawn(handleErrorPrompt, child)
        end
    end

    promptConnection = overlay.ChildAdded:Connect(function(child)
        if child.Name == "ErrorPrompt" then
            task.spawn(handleErrorPrompt, child)
        end
    end)
end)

-- Handle failed teleport state.
pcall(function()
    teleportStateConnection = LocalPlayer.OnTeleport:Connect(
        function(state)
            if stopped then
                return
            end

            if tostring(state) == "Enum.TeleportState.Failed"
                and currentTarget
            then
                currentTarget = nil
                requestReconnect("Teleport state failed")
            end
        end
    )
end)
