--[[
    Auto Reconnect By Ambatukam
]]

repeat task.wait(1) until game:IsLoaded()

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local PlaceId = game.PlaceId

-- Configuration
local CONFIG = {
    ScanDelay = 4,
    RetryDelay = 5,
    MaxRetryDelay = 30,
    MaxPages = 5,
    RequestTimeout = 10,
    MaxTeleportAttempts = 8,
    MinFreeSlots = 1,
}

-- Error codes that stop Auto Reconnect
local STOP_CODES = {
    268, 256, 273, 264, 270, 278,
    280, 403, 524, 600, 6000, 1001
}

-- Error codes that trigger Auto Reconnect
local RECONNECT_CODES = {
    266, 277, 279
}

-- Runtime state
local excludedServers = {}
local busy = false
local stopped = false
local teleportAttempts = 0
local lastError = ""
local currentTarget = nil
local promptConnection = nil
local teleportFailedConnection = nil
local lastPrompt = nil

-- Only startup output.
print("Auto Rejoin: Active")

local function stopReconnect()
    stopped = true
    busy = false
    currentTarget = nil
end

local function getBackoff(attempt)
    return math.min(
        CONFIG.RetryDelay * (2 ^ math.max(0, attempt - 1)),
        CONFIG.MaxRetryDelay
    )
end

local function requestJson(url)
    local ok, result = pcall(function()
        local response = game:HttpGet(url)
        return HttpService:JSONDecode(response)
    end)

    if not ok or type(result) ~= "table" then
        return nil, tostring(result)
    end

    return result
end

-- Find a public server with available player slots.
local function findPublicServer()
    local cursor = nil

    for page = 1, CONFIG.MaxPages do
        if stopped then
            return nil
        end

        local url = "https://games.roblox.com/v1/games/"
            .. tostring(PlaceId)
            .. "/servers/Public?sortOrder=Asc&limit=100"

        if cursor and cursor ~= "" then
            url = url .. "&cursor="
                .. HttpService:UrlEncode(cursor)
        end

        local data, err = requestJson(url)

        if not data then
            lastError = err or "Server API request failed"
            return nil
        end

        if type(data.data) == "table" then
            for _, server in ipairs(data.data) do
                local id = server.id
                local playing = tonumber(server.playing) or 0
                local maximum = tonumber(server.maxPlayers) or 0

                if id
                    and tostring(id) ~= tostring(game.JobId)
                    and not excludedServers[tostring(id)]
                    and maximum - playing >= CONFIG.MinFreeSlots
                then
                    return tostring(id)
                end
            end
        end

        cursor = data.nextPageCursor

        if not cursor or cursor == "" then
            break
        end

        task.wait(0.25)
    end

    return nil
end

local function attemptTeleport(serverId)
    if stopped or not serverId then
        return false
    end

    excludedServers[tostring(serverId)] = true
    currentTarget = tostring(serverId)

    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(
            PlaceId,
            tostring(serverId),
            LocalPlayer
        )
    end)

    if not ok then
        lastError = tostring(err)
        return false
    end

    return true
end

-- Only one reconnect worker can run at a time.
local function requestReconnect(reason)
    if stopped or busy then
        return
    end

    busy = true
    teleportAttempts = 0

    task.spawn(function()
        while not stopped
            and teleportAttempts < CONFIG.MaxTeleportAttempts
        do
            teleportAttempts += 1

            local serverId = findPublicServer()

            if serverId then
                local started = attemptTeleport(serverId)

                if started then
                    local deadline = os.clock() + 12

                    while not stopped
                        and os.clock() < deadline
                        and currentTarget == serverId
                    do
                        task.wait(0.5)

                        if game.PlaceId ~= PlaceId then
                            stopReconnect()
                            return
                        end
                    end
                end
            end

            if not stopped then
                currentTarget = nil
                task.wait(getBackoff(teleportAttempts))
            end
        end

        busy = false
    end)
end

-- Read text exposed by Roblox UI descendants, not pixel OCR.
local function readPromptText(prompt)
    local parts = {}

    local function collectText(object)
        if object:IsA("TextLabel")
            or object:IsA("TextButton")
            or object:IsA("TextBox")
        then
            local value = object.Text

            if type(value) == "string" and value ~= "" then
                table.insert(parts, value)
            end
        end
    end

    collectText(prompt)

    for _, descendant in ipairs(prompt:GetDescendants()) do
        collectText(descendant)
    end

    return table.concat(parts, " ")
end

local function containsCode(message, code)
    local pattern = "%f[%d]" .. tostring(code) .. "%f[^%d]"
    return string.find(message, pattern) ~= nil
end

local function handleErrorPrompt(prompt)
    if stopped or prompt == lastPrompt then
        return
    end

    lastPrompt = prompt

    local message = ""

    -- Wait briefly for Roblox to populate the error text.
    for _ = 1, 8 do
        if stopped or not prompt.Parent then
            return
        end

        message = readPromptText(prompt)
        local normalized = string.lower(message)

        -- These codes stop Auto Reconnect.
        for _, code in ipairs(STOP_CODES) do
            if containsCode(normalized, code) then
                stopReconnect()
                return
            end
        end

        if message ~= "" then
            break
        end

        task.wait(0.25)
    end

    if stopped then
        return
    end

    -- These codes trigger Auto Reconnect.
    for _, code in ipairs(RECONNECT_CODES) do
        if containsCode(message, code) then
            requestReconnect("Recognized connection error")
            return
        end
    end
end

-- Handle teleport attempts that fail to start.
pcall(function()
    teleportFailedConnection =
        TeleportService.TeleportInitFailed:Connect(
            function(player, result, errorMessage)
                if player ~= LocalPlayer or stopped then
                    return
                end

                lastError = tostring(errorMessage)
                currentTarget = nil
                busy = false

                task.delay(1, function()
                    if not stopped then
                        requestReconnect("Teleport failed")
                    end
                end)
            end
        )
end)

-- Watch Roblox error prompts.
task.spawn(function()
    local promptGui = CoreGui:WaitForChild(
        "RobloxPromptGui",
        30
    )

    if not promptGui or stopped then
        return
    end

    local overlay = promptGui:FindFirstChild("promptOverlay")

    if not overlay then
        overlay = promptGui:WaitForChild("promptOverlay", 15)
    end

    if not overlay or stopped then
        return
    end

    -- Inspect any error prompt that already exists.
    for _, child in ipairs(overlay:GetChildren()) do
        if child.Name == "ErrorPrompt" then
            task.spawn(handleErrorPrompt, child)
        end
    end

    promptConnection = overlay.ChildAdded:Connect(function(child)
        if child.Name == "ErrorPrompt" then
            task.spawn(handleErrorPrompt, child)
        end
    end)
end)

-- Watch for teleport state failures.
pcall(function()
    LocalPlayer.OnTeleport:Connect(function(state)
        if stopped then
            return
        end

        if tostring(state) == "Enum.TeleportState.Failed" then
            currentTarget = nil
            busy = false

            task.delay(1, function()
                if not stopped then
                    requestReconnect("Teleport state failed")
                end
            end)
        end
    end)
end)
