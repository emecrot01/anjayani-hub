local SellItemRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Shop"):WaitForChild("SellItem")

-- List rarity & state toggle
local raritiesSell = {
    {Name="Common",Emoji="⚪"},
    {Name="Uncommon",Emoji="🟢"},
    {Name="Rare",Emoji="🔵"},
    {Name="Epic",Emoji="🟣"},
    {Name="Legendary",Emoji="🟡"},
    {Name="Mythic",Emoji="🔴"},
    {Name="Exotic",Emoji="💎"},
}
local autoSellState = {}
for _,r in ipairs(raritiesSell) do autoSellState[r.Name]=false end

-- ===== Queue + Anti-cheat layer =====
local q = {head=1, tail=0, data={}}
local queued = setmetatable({}, {__mode="k"}) -- weak keys (dedup)

local function q_push(tool)
    if queued[tool] then return end
    q.tail += 1
    q.data[q.tail] = tool
    queued[tool] = true
end

local function q_pop()
    if q.head > q.tail then return nil end
    local tool = q.data[q.head]
    q.data[q.head] = nil
    q.head += 1
    queued[tool] = nil
    return tool
end

-- Delay system safe & cepat
local SAFE_DELAY_ITEM_MIN, SAFE_DELAY_ITEM_MAX = 0.05, 0.3
local SAFE_DELAY_SWEEP_MIN, SAFE_DELAY_SWEEP_MAX = 0.05, 0.2
local WORKERS = 10
local MAX_PER_SWEEP = 15

local function randDelayItem()
    task.wait(math.random(SAFE_DELAY_ITEM_MIN*1000, SAFE_DELAY_ITEM_MAX*1000)/1000)
end

local function randDelaySweep()
    task.wait(math.random(SAFE_DELAY_SWEEP_MIN*1000, SAFE_DELAY_SWEEP_MAX*1000)/1000)
end

-- Validasi sebelum jual
local function isSellable(tool)
    if not tool or not tool.Parent then return false end
    if tool.Parent ~= Backpack then return false end
    if not tool:IsA("Tool") then return false end
    if tool:GetAttribute("Locked") == true then return false end
    if tool:GetAttribute("Equipped") == true or tool.Parent == LocalPlayer.Character then return false end
    local rarity = tool:GetAttribute("Rarity")
    if not rarity or autoSellState[rarity] ~= true then return false end
    return true
end

-- Safe invoke sell
local function safeInvokeSell(tool)
    if not isSellable(tool) then return false end
    local ok, res = pcall(function()
        return SellItemRemote:InvokeServer(tool)
    end)
    if not ok then
        randDelayItem()
        ok, res = pcall(function()
            return SellItemRemote:InvokeServer(tool)
        end)
    end
    return ok and (res == true or res == "Success")
end

-- Backpack event → auto masuk queue
Backpack.ChildAdded:Connect(function(tool)
    if not tool or not tool:IsA("Tool") then return end
    task.delay(math.random(0,30)/100, function()
        local rarity = tool:GetAttribute("Rarity")
        if rarity and autoSellState[rarity] then
            q_push(tool)
        end
    end)
end)

-- Periodic backfill
task.spawn(function()
    while true do
        task.wait(math.random(25,60)/100)
        for _, tool in ipairs(Backpack:GetChildren()) do
            if tool:IsA("Tool") then
                local rarity = tool:GetAttribute("Rarity")
                if rarity and autoSellState[rarity] and not queued[tool] then
                    q_push(tool)
                end
            end
        end
    end
end)

-- Worker pool
for i = 1, WORKERS do
    task.spawn(function()
        while true do
            local queueLength = q.tail - q.head + 1
            local takeN = math.min(MAX_PER_SWEEP, queueLength)
            for _ = 1, takeN do
                local tool = q_pop()
                if not tool then break end
                if isSellable(tool) then
                    safeInvokeSell(tool)
                    randDelayItem()
                end
            end
            randDelaySweep()
        end
    end)
end

-- UI: Toggle per rarity
for _, r in ipairs(raritiesSell) do
    TabSell:CreateToggle({
        Name = r.Emoji .. " Auto Sell " .. r.Name,
        CurrentValue = false,
        Callback = function(state)
            autoSellState[r.Name] = state
        end
    })
end

