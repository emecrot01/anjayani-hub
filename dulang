            Rayfield:Notify({Title = "Error", Content = "Gagal mengambil biaya reforge: " .. tostring(errCost), Duration = 1})
            return
        end
 
        Rayfield:Notify({Title = "Reforge Cost", Content = "Biaya reforge item ini: " .. tostring(cost), Duration = 1})
        task.wait(0.25)
 
        local result
        local success, err = pcall(function()
            result = RS.Remotes.Crafting.ReforgeEquipment:InvokeServer(tool)
        end)
 
        if success and result then
            Rayfield:Notify({Title = "Reforge Success!", Content = "Item berhasil di-reforge ⚡", Duration = 1})
        else
            Rayfield:Notify({Title = "Reforge Failed", Content = "Terjadi error: " .. tostring(err or result), Duration = 1})
        end
    end
})
 
