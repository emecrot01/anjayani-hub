-- ===== DETEKSI JENIS HARGA =====
local function getPriceType(item)
	if not item:FindFirstChild("ShopItem") then 
		return "Unknown" 
	end

	local shopItem = item.ShopItem

	if shopItem:GetAttribute("ShardPrice") 
	and shopItem:GetAttribute("ShardPrice") > 0 then
		
		return "Shard"

	elseif shopItem:GetAttribute("Price") 
	and shopItem:GetAttribute("Price") > 0 then
		
		return "Money"
	end

	return "Unknown"
end


