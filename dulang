-- 🔥 Auto Farm dengan logika 1–5
TabFarm:CreateToggle({
    Name="Auto Farm",
    CurrentValue=false,
    Callback=function(state)
        autoFarm=state
        if not state then
            notify("Auto Farm","Stopped ❌")
            return
        end
        notify("Auto Farm","Started ✅")

        task.spawn(function()
            while autoFarm do
                if not savedSandCF or not savedWaterCF then
                    task.wait(0.5)
                else
                    local tool, cap=getTool(), getCapacity()
                    local fill=getFill(tool)
                    if tool and cap and fill then
                        -- 1. Gali di Sand
                        if fill<cap then
                            moveTo(savedSandCF)
                            digUntilFull()
                        -- 2. Trigger Pan di Water
                        elseif fill>=cap then
                            moveTo(savedWaterCF)
                            if ensurePanStarted(getTool(),15,0.08) then
                                -- 3. Shake sambil balik ke Sand
                                local shaking=true
                                task.spawn(function()
                                    shakeLoop()
                                    shaking=false
                                end)

                                moveTo(savedSandCF)

                                -- 4. Kalau Shake masih jalan, tunggu selesai
                                while autoFarm and panIsActive() do
                                    local _,_,shake=getRemotes(getTool())
                                    if shake then callRemote(shake) end
                                    randDelay(0.04,0.07)
                                end
                            end
                        end
                    end
                end
                randDelay(0.05,0.15)
            end
        end)
    end
})

-- Helper toggle tetap sama
TabFarm:CreateToggle({
    Name="Auto Collect + Shake ⛏️💧",
    CurrentValue=false,
    Callback=function(state)
        autoHelper=state
        if not state then
            notify("Auto Collect + Shake","Stopped ❌")
            return
        end
        notify("Auto Collect + Shake","Activate ✅")
        task.spawn(function()
            local lastPan=0
            while autoHelper do
                local tool, cap=getTool(), getCapacity()
                local fill=getFill(tool)
                if tool and cap and fill then
                    if panIsActive() then
                        local _,_,shake=getRemotes(tool)
                        if shake then callRemote(shake) end
                        randDelay(0.04,0.07)
                    elseif fill>=cap then
                        if os.clock()-lastPan>0.4 then
                            local _,pan=getRemotes(tool)
                            if pan then callRemote(pan) end
                            lastPan=os.clock()
                        end
                        randDelay(0.1,0.2)
                    else
                        local collect=select(1,getRemotes(tool))
                        if collect then callRemote(collect,1) end
                        randDelay(0.08,0.2)
                    end
                else
                    task.wait(0.2)
                end
            end
        end)
    end
})

