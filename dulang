-- ⚡ Instant Interact (No Hold)

local instantEnabled = false
local originalDurations = {}

local function applyInstant()
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            if not originalDurations[prompt] then
                originalDurations[prompt] = prompt.HoldDuration
            end
            prompt.HoldDuration = 0
        end
    end
end

local function restoreHold()
    for prompt, duration in pairs(originalDurations) do
        if prompt and prompt.Parent then
            prompt.HoldDuration = duration
        end
    end
end

-- detect prompt baru
workspace.DescendantAdded:Connect(function(obj)
    if instantEnabled and obj:IsA("ProximityPrompt") then
        task.wait()
        if not originalDurations[obj] then
            originalDurations[obj] = obj.HoldDuration
        end
        obj.HoldDuration = 0
    end
end)

