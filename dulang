-- ===== FUNCTION AMBIL DATA DARI ITEMDATA =====
local function GetItemAttribute(tool, attr)
    local itemData = tool:FindFirstChild("ItemData")
    if itemData and itemData:GetAttribute(attr) then
        return itemData:GetAttribute(attr)
    end
    return "Unknown"
end

-- ===== FUNCTION KIRIM WEBHOOK =====
local function SendWebhook(tool)
    if not WebhookEnabled or WebhookURL == "" or not req then return end
    if not IsRaritySelected(tool) then return end

    local data = GetOreData(tool.Name)
    data = data and (data[1] or data) or {}

    local rarity = tool:GetAttribute("Rarity") or "Unknown"
    local formatted = ""
    for _, r in ipairs({
        {Name="Common", Emoji="⚪"},
        {Name="Uncommon", Emoji="🟢"},
        {Name="Rare", Emoji="🔵"},
        {Name="Epic", Emoji="🟣"},
        {Name="Legendary", Emoji="🟡"},
        {Name="Mythic", Emoji="🔴"},
        {Name="Exotic", Emoji="💎"}
    }) do
        if r.Name == rarity then
            formatted = r.Emoji .. " " .. r.Name
            break
        end
    end

    -- Ambil data runtime dari ItemData
    local modifier = GetItemAttribute(tool, "Modifier")
    local price = GetItemAttribute(tool, "Price")
    local size = GetItemAttribute(tool, "Weight")

    local embed = {
        title = "📦 Item Baru Diperoleh!",
        description = string.format(
            "**Ore:** %s\n**Rarity:** %s\n**Modifier:** %s\n**Price:** `$%s`\n**Size:** %s KG",
            tool.Name, formatted, modifier, price, size
        ),
        color = 0x1abc9c,
        footer = { text = "Anjayani Hub X Mammoth King👑" }
    }

    if data.Image then
        embed.thumbnail = { url = data.Image }
    end

    local body = {
        username = "Prospecting Bot 💎",
        embeds = { embed }
    }

    pcall(function()
        req({
            Url = WebhookURL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(body)
        })
    end)
end

