            local pos = char.HumanoidRootPart.Position
            local text = string.format("X: %.2f | Y: %.2f | Z: %.2f", pos.X, pos.Y, pos.Z)
            
            if setclipboard then
                setclipboard(text)
            end
            
            Rayfield:Notify({
                Title = "Copy Coordinate 📍📋",
                Content = text,
                Duration = 1
            })
        end
    end)
    
    -- UPDATE LOOP
    coordUpdating = true
    task.spawn(function()
        while coordUpdating and coordGui do
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local pos = char.HumanoidRootPart.Position
                coordText.Text = string.format(
                    "X: %.2f | Y: %.2f | Z: %.2f",
                    pos.X, pos.Y, pos.Z
                )
            end
            task.wait(0.1)
        end
    end)
end

-- REMOVE UI
local function removeCoordinateUI()
    if not coordGui then return end
    
    local main = coordGui:FindFirstChildOfClass("Frame")
    local coordText = main and main:FindFirstChildOfClass("TextLabel")
    local copyBtn = main and main:FindFirstChildOfClass("TextButton")
    
    -- 🔥 FADE OUT (1 DETIK)
    TweenService:Create(main, TweenInfo.new(1), {
        BackgroundTransparency = 1
    }):Play()
    
    if coordText then
        TweenService:Create(coordText, TweenInfo.new(1), {
            TextTransparency = 1
        }):Play()
    end
    
    if copyBtn then
        TweenService:Create(copyBtn, TweenInfo.new(1), {
            TextTransparency = 1,
            BackgroundTransparency = 1
        }):Play()
    end
    
    task.delay(1, function()
        coordUpdating = false
        if coordGui then
            coordGui:Destroy()
            coordGui = nil
        end
    end)
end

-- TOGGLE
TabMisc:CreateToggle({
    Name = "Show Coordinate 📍",
    CurrentValue = false,
    Callback = function(state)
        if state then
            createCoordinateUI()
            Rayfield:Notify({
                Title = "Coordinate 📍",
                Content = "Showing Coordinate 📍👀",
                Duration = 1
            })
        else
            removeCoordinateUI()
            Rayfield:Notify({
                Title = "Coordinate 📍",
                Content = "Closing Coordinate 📍⛔",
                Duration = 1
            })
        end
    end
})
