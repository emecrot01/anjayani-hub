-- Remote
local ToggleLockRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Inventory"):WaitForChild("ToggleLock")
 
-- Rarity list khusus Lock
local raritiesLock = {
    {Name = "Common",    Emoji = "⚪"},
    {Name = "Uncommon",  Emoji = "🟢"},
    {Name = "Rare",      Emoji = "🔵"},
    {Name = "Epic",      Emoji = "🟣"},
