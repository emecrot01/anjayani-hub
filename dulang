-- TAB 2: Auto Farm ⛏️
local TabFarm = Window:CreateTab("Auto Farm ⛏️")

-- // Services
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer

-- // Helpers
local function character() return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait() end
local function HRP() local c=character() return c and c:FindFirstChild("HumanoidRootPart") end
local function Humanoid() local c=character() return c and c:FindFirstChildOfClass("Humanoid") end

-- // State
local savedSandCF, savedWaterCF = nil, nil
local movementMethod = "Walk 👟"
local autoFarm, autoHelper = false, false

-- // Utils
local function notify(title, content, dur)
    Rayfield:Notify({Title=title, Content=content, Duration=dur or 2})
end

local function randDelay(min, max)
    task.wait(math.random()*(max-min)+min)
end

local function getTool()
    local c=character()
    return c and c:FindFirstChildOfClass("Tool")
end

local function getCapacity()
    local stats=LocalPlayer:FindFirstChild("Stats")
    return stats and stats:GetAttribute("Capacity")
end

local function getFill(tool)
    return tool and tool:GetAttribute("Fill")
end

local function panIsActive()
    local c=character()
    return c and c:GetAttribute("Panning")==true
end

local function getRemotes(tool)
    if not tool then return end
    local scripts=tool:FindFirstChild("Scripts")
    if not scripts then return end
    return scripts:FindFirstChild("Collect"), scripts:FindFirstChild("Pan"), scripts:FindFirstChild("Shake")
end

local function callRemote(remote, ...)
    if not remote then return false end
    local ok
    if remote.ClassName=="RemoteFunction" then
        ok=pcall(function(...) remote:InvokeServer(...) end, ...)
    elseif remote.ClassName=="RemoteEvent" then
        ok=pcall(function(...) remote:FireServer(...) end, ...)
    end
    return ok and true or false
end

-- // Movement
local function moveTo(cf)
    local hrp, hum = HRP(), Humanoid()
    if not hrp or not hum or not cf then return end

    if movementMethod=="Walk 👟" then  
        hum:MoveTo(cf.Position)  
        local done, conn=false
        conn=hum.MoveToFinished:Connect(function() done=true conn:Disconnect() end)  
        local t0=tick()  
        while not done and tick()-t0<8 do randDelay(0.1,0.25) end  

    elseif movementMethod=="Smooth Teleport ⚡" then  
        local tw=TweenService:Create(hrp, TweenInfo.new(math.random(5,10)/10), {CFrame=cf})  
        tw:Play() tw.Completed:Wait()  

    else -- Instant Teleport ⚡⚡
        hrp.CFrame=cf  
        randDelay(0.6,1.2)  
    end
end

-- // Farm Helpers
local function ensurePanStarted(tool, tries, delay)
    tries, delay = tries or 10, delay or 0.1
    for _=1,tries do
        if panIsActive() then return true end
        local _, panRemote = getRemotes(tool)
        if panRemote then callRemote(panRemote) end
        randDelay(delay, delay+0.05)
        if panIsActive() then return true end
    end
    return panIsActive()
end

local function digUntilFull()
    local tool, cap=getTool(), getCapacity()
    if not tool or not cap then return end
    VirtualInputManager:SendMouseButtonEvent(0,0,0,true,game,0)

    while autoFarm do
        tool, cap=getTool(), getCapacity()
        local fill=getFill(tool)
        if not tool or not cap or not fill then break end
        if fill>=cap then break end

        local collect=select(1,getRemotes(tool))
        if collect then callRemote(collect,1) end
        randDelay(0.08,0.2) -- dig
    end

    VirtualInputManager:SendMouseButtonEvent(0,0,0,false,game,0)
end

-- 🔥 Shake lebih cepat
local function shakeLoop()
    while autoFarm and panIsActive() do
        local _,_,shake=getRemotes(getTool())
        if shake then callRemote(shake) end
        randDelay(0.04,0.07)
    end
end

