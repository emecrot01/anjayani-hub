        while true do
            if autoSellEnabled then
                local queueLength = q.tail - q.head + 1
                local takeN = math.min(MAX_PER_SWEEP, queueLength)
                for _ = 1, takeN do
                    local tool = q_pop()
                    if not tool then break end
                    if isSellable(tool) then
                        safeInvokeSell(tool)
                        randDelayItem()
                    end
                end
                randDelaySweep()
            else
                task.wait(0.2)
            end
        end
    end)
end

-- ===== AUTO LOCK SYSTEM =====
local function rand_delay()
    task.wait(math.random(20, 35) / 100)
end

local lockQueue = {}
local function queueLock(item)
    if not autoLockEnabled then return end
    if not item or not item:IsA("Tool") then return end
    if item.Parent ~= Backpack then return end
    local rarity = item:GetAttribute("Rarity")
    local isLocked = item:GetAttribute("Locked")
    if rarity and autoLockState[rarity] and (isLocked == false or isLocked == nil) then
        table.insert(lockQueue, item)
    end
end

local MAX_WORKERS = 3
local function worker()
    while true do
        if autoLockEnabled then
            local item = table.remove(lockQueue, 1)
            if item and item:IsDescendantOf(Backpack) then
                pcall(function()
                    ToggleLockRemote:FireServer(item)
                end)
                rand_delay()
            else
                task.wait(0.1)
            end
        else
            task.wait(0.2)
        end
    end
end
for i = 1, MAX_WORKERS do
    task.spawn(worker)
end

Backpack.ChildAdded:Connect(function(tool)
    task.wait(0.1)
    queueLock(tool)
    tool.AttributeChanged:Connect(function(attr)
        if attr == "Locked" and tool:GetAttribute("Locked") == false then
            queueLock(tool)
        end
    end)
end)

task.spawn(function()
    while true do
        if autoLockEnabled then
            for _, tool in ipairs(Backpack:GetChildren()) do
                queueLock(tool)
            end
        end
        task.wait(5)
    end
end)

