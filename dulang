-- 💎 Auto Geode FINAL v9 (Smart Hover + Obstacle + Respawn Safe)
 
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
 
local geodeFolder = Workspace:WaitForChild("Geode")
local player = game.Players.LocalPlayer
 
local hrp = nil
local autoGeode = false
local visited = {}
 
local FLY_HEIGHT = 100
local DROP_HEIGHT = 1
local SPEED = 100
local UP_SPEED = 100
local DOWN_SPEED = 100
local HOVER_THRESHOLD = 200
 
-- refresh HRP
local function refreshHRP()
    local char = player.Character or player.CharacterAdded:Wait()
    hrp = char:WaitForChild("HumanoidRootPart")
end
 
refreshHRP()
player.CharacterAdded:Connect(refreshHRP)
 
-- tween helper
local function tweenToPosition(targetPos, customSpeed)
    local distance = (hrp.Position - targetPos).Magnitude
    local time = distance / (customSpeed or SPEED)
 
    local lookVector = hrp.CFrame.LookVector
    local targetCFrame = CFrame.new(targetPos, targetPos + lookVector)
 
    local tween = TweenService:Create(
        hrp,
        TweenInfo.new(time, Enum.EasingStyle.Linear),
        {CFrame = targetCFrame}
    )
 
    tween:Play()
    tween.Completed:Wait()
end
 
-- collect geode
local function collectGeode(part)
    if part and part:FindFirstChildOfClass("TouchTransmitter") then
        firetouchinterest(hrp, part, 0)
        firetouchinterest(hrp, part, 1)
        task.wait(0.35)
    end
end
 
-- naik ke atas (untuk toggle ON)
local function goUp()
    local currentPos = hrp.Position
    local targetPos = Vector3.new(currentPos.X, currentPos.Y + FLY_HEIGHT, currentPos.Z)
    tweenToPosition(targetPos, UP_SPEED)
end
 
-- cek obstacle pakai raycast
local function isPathBlocked(targetPos)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.FilterDescendantsInstances = {player.Character}
    local direction = targetPos - hrp.Position
    local result = Workspace:Raycast(hrp.Position, direction, rayParams)
    return result ~= nil
end
 
-- cari geode terdekat (dynamic)
local function getNearestGeode()
    local closestPart = nil
    local closestModel = nil
    local shortest = math.huge
 
    for _, g in ipairs(geodeFolder:GetChildren()) do
        if g:IsA("Model") then
            local part = g:FindFirstChild("Part")
            if part and part:FindFirstChildOfClass("TouchTransmitter") then
                local dist = (hrp.Position - part.Position).Magnitude
                if dist < shortest then
                    shortest = dist
                    closestPart = part
                    closestModel = g
                end
            end
        end
    end
 
    return closestModel, closestPart
end
 
-- loop utama
task.spawn(function()
    while true do
        if autoGeode and hrp then
            local model, part = getNearestGeode()
 
            if model and part then
                local basePos = part.Position
 
                -- hitung jarak horizontal (XZ plane)
                local hrpXZ = Vector3.new(hrp.Position.X, 0, hrp.Position.Z)
                local baseXZ = Vector3.new(basePos.X, 0, basePos.Z)
                local horizontalDist = (hrpXZ - baseXZ).Magnitude
 
                local blocked = isPathBlocked(basePos)
 
                if horizontalDist < HOVER_THRESHOLD and not blocked then
                    -- dekat & jalur clear → langsung turun
                    tweenToPosition(basePos + Vector3.new(0, DROP_HEIGHT, 0), SPEED)
                else
                    -- jarak jauh atau ada obstacle → hover
                    local hoverPos = Vector3.new(hrp.Position.X, basePos.Y + FLY_HEIGHT, hrp.Position.Z)
                    tweenToPosition(hoverPos, UP_SPEED)
 
                    tweenToPosition(basePos + Vector3.new(0, FLY_HEIGHT, 0))
 
                    tweenToPosition(basePos + Vector3.new(0, DROP_HEIGHT, 0), DOWN_SPEED)
                end
 
                task.wait(0.1)
                collectGeode(part)
 
                -- tandai sudah dikunjungi untuk session ini
                visited[model] = tick()
            else
                task.wait(1)
            end
        end
        task.wait(0.1)
    end
end)
 
