local function getDigBar()
    local ok, dig = pcall(function()
        return PlayerGui:WaitForChild("ToolUI"):WaitForChild("DigBar")
    end)
    return ok and dig or nil
end

local DigBar = getDigBar()
local PerfectHitEnabled = false
local Padding = 2

-- Helper untuk cek tengah bar di dalam GradientFrame
local function checkCenterHit(bar, frame, pad)
    local barPos, barSize = bar.AbsolutePosition, bar.AbsoluteSize
    local framePos, frameSize = frame.AbsolutePosition, frame.AbsoluteSize

    local barCenterX = barPos.X + (barSize.X / 2)
    local barCenterY = barPos.Y + (barSize.Y / 2)

    local fLeft   = framePos.X - pad
    local fRight  = framePos.X + frameSize.X + pad
    local fTop    = framePos.Y - pad
    local fBottom = framePos.Y + frameSize.Y + pad

    return (barCenterX >= fLeft and barCenterX <= fRight) and
           (barCenterY >= fTop and barCenterY <= fBottom)
end

local function pressMouse()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
end

local function releaseMouse()
