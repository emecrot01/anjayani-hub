local TabFarm = Window:CreateTab("Auto Farm ⛏️💧")

local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer

local function character() return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait() end
local function HRP() local c=character() return c and c:FindFirstChild("HumanoidRootPart") end

local savedSandCF, savedWaterCF = nil, nil
local autoFarm = false
local currentTween = nil

-- 🔥 FAST TWEEN
local function fastTween(targetCF)
    local hrp = HRP()
    if not hrp then return false end

    if currentTween then
        pcall(function() currentTween:Cancel() end)
    end

    local dist = (hrp.Position - targetCF.Position).Magnitude
    local time = math.clamp(dist / 300, 0.05, 0.12)

    currentTween = TweenService:Create(
        hrp,
        TweenInfo.new(time, Enum.EasingStyle.Linear),
        {CFrame = targetCF}
    )

    currentTween:Play()

    local start = tick()

    while tick() - start < time + 0.2 do
        if not autoFarm then return false end
        local h = HRP()
        if h and (h.Position - targetCF.Position).Magnitude < 3 then
            return true
        end
        task.wait()
    end

    local h = HRP()
    if h then h.CFrame = targetCF end
    return true
end

-- TOOL
local function getTool()
    local c=character()
    return c and c:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
end

local function equipPan()
    local tool = getTool()
    if tool and tool.Parent ~= character() then
        tool.Parent = character()
        task.wait(0.1)
    end
    return tool
end

local function getCapacity()
    local stats=LocalPlayer:FindFirstChild("Stats")
    return stats and stats:GetAttribute("Capacity")
end

local function getFill(tool)
    return tool and tool:GetAttribute("Fill")
end

local function panIsActive()
    local c=character()
    return c and c:GetAttribute("Panning")==true
end

local function getRemotes(tool)
    if not tool then return end
    local scripts=tool:FindFirstChild("Scripts")
    if not scripts then return end
    return scripts:FindFirstChild("Collect"), scripts:FindFirstChild("Pan"), scripts:FindFirstChild("Shake")
end

local function callRemote(remote, ...)
    if not remote then return end
    pcall(function(...)
        if remote.ClassName=="RemoteFunction" then
            remote:InvokeServer(...)
        else
            remote:FireServer(...)
        end
    end, ...)
end

local function randDelay(min, max)
    task.wait(math.random()*(max-min)+min)
end

-- 🔥 DIG
local function digUntilFull()
    local tool, cap = equipPan(), getCapacity()
    if not tool or not cap then return end

    VirtualInputManager:SendMouseButtonEvent(0,0,0,true,game,0)

    while autoFarm do
        tool, cap = equipPan(), getCapacity()
        local fill = getFill(tool)

        if not tool or not fill or fill >= cap then break end

        local collect = select(1,getRemotes(tool))
        if collect then callRemote(collect,1) end

        randDelay(0.06,0.10) -- 🔥 DIG SPEED
    end

    VirtualInputManager:SendMouseButtonEvent(0,0,0,false,game,0)
end

-- 🔥 PAN START
local function ensurePanStarted()
    for _=1,10 do
        if panIsActive() then return true end
        local _, panRemote = getRemotes(getTool())
        if panRemote then callRemote(panRemote) end
        randDelay(0.07,0.10) -- 🔥 PAN SPEED
    end
    return false
end

-- 🔥 SHAKE
local function startShakeThread()
    task.spawn(function()
        while autoFarm and panIsActive() do
            local _,_,shake = getRemotes(getTool())
            if shake then callRemote(shake) end

            randDelay(0.03,0.05) -- 🔥 SHAKE SPEED
        end
    end)
end

-- 🔥 OVERLAP: DIG SAAT BALIK
local function overlapDig()
    task.spawn(function()
        local start = tick()
        while autoFarm and (tick() - start < 1.5) do
            local collect = select(1,getRemotes(getTool()))
            if collect then callRemote(collect,1) end
            randDelay(0.05,0.08)
        end
    end)
end

-- 🔥 OVERLAP: PRE SHAKE
local function preShake()
    task.spawn(function()
        for i=1,5 do
            if not autoFarm then break end
            local _,_,shake = getRemotes(getTool())
            if shake then callRemote(shake) end
            randDelay(0.04,0.06)
        end
    end)
end

